# DX Student Help — production environment
# Copy to .env on the server, fill in every value, then run:
#   php artisan key:generate
#   php artisan platform:security-check

APP_NAME="DX Student Help"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://x-student-help.mcs.bz

APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en

# Two front doors, one application. Both subdomains point at the same folder.
STUDENT_PORTAL_HOST=x-student-help.mcs.bz
TEACHER_PORTAL_HOST=x-teacher-help.mcs.bz
STUDENT_PORTAL_NAME="DX Student Help"
TEACHER_PORTAL_NAME="The X Teacher Help"
# Must be false in production, or the wrong-door redirect never fires
PORTAL_ALLOW_SHARED_HOST=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis. If Redis is not installed yet, see docs/DEPLOYMENT.md step 6;
# the fallback values are in that document too.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Mail is configured in the admin Gateways screen, not here. These are only
# the fallback used before a gateway is set up.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@mcs.bz
MAIL_FROM_NAME="DX Student Help"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
