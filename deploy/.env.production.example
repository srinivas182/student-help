# ---------------------------------------------------------------------------
# DX Student Help — production environment
# Copy to .env on the server, fill every CHANGE_ME, then:
#   php artisan key:generate
#   php artisan platform:security-check
# ---------------------------------------------------------------------------

APP_NAME="DX Student Help"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://x-student-help.mcs.bz
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en

# Two front doors, one application
STUDENT_PORTAL_HOST=x-student-help.mcs.bz
TEACHER_PORTAL_HOST=x-teacher-help.mcs.bz
STUDENT_PORTAL_NAME="DX Student Help"
TEACHER_PORTAL_NAME="The X Teacher Help"
# Must be false in production, or the wrong-door redirect stops working
PORTAL_ALLOW_SHARED_HOST=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# cPanel creates these with the account prefix, e.g. dxstuden_app
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# predis is installed, so no phpredis extension is required
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
# Keeps this app's keys separate if anything else ever shares the Redis server
REDIS_PREFIX=dxsh_

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Mail is configured in the admin Gateways screen, not here.
# These are only the fallback before a gateway is set up.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@mcs.bz
MAIL_FROM_NAME="DX Student Help"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
