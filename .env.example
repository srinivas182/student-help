APP_NAME="DX Student Help"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://student-help.rightally.io
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# cPanel/WHM: create the database and user in cPanel, then paste the values here
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dxstudent_app
DB_USERNAME=dxstudent_app
DB_PASSWORD=

# Redis is installed over SSH (not part of a standard cPanel build).
# If Redis is unavailable, set these three to "database" / "file" and the app still runs.
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Never send platform email through cPanel mail — deliverability will fail.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rightally.io"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
